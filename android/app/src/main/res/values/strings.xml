    <!-- v1.1: onboarding -->
    <string name="onboarding_title">Set up NUVA</string>
    <string name="onboarding_intro">Give only the permissions you want, when you want them. Everything is optional — NUVA simply tells you what needs which permission.</string>
    <string name="perm_mic_title">🎙 Microphone</string>
    <string name="perm_mic_desc">Needed to hear your voice commands. The mic only runs while the listening indicator is visible — never in the background.</string>
    <string name="perm_notifications_title">🔔 Notifications</string>
    <string name="perm_notifications_desc">Shows NUVA\'s listening status and results as a notification. Optional.</string>
    <string name="perm_accessibility_title">♿ Accessibility service</string>
    <string name="perm_accessibility_desc">Lets NUVA read the screen aloud and press buttons you name (screen reading, WhatsApp send, scroll). Enabled manually in system settings — NUVA can never turn it on itself.</string>
    <string name="perm_contacts_title">👥 Contacts</string>
    <string name="perm_contacts_desc">Needed to find a number when you say “call Rahim”. Requested only when you first run a call/message command.</string>
    <string name="perm_sms_title">✉ SMS</string>
    <string name="perm_sms_desc">Lets NUVA send an SMS after you confirm. Without it NUVA opens the SMS screen pre-filled and you press Send yourself.</string>
    <string name="perm_notif_listener_title">📩 Notification access</string>
    <string name="perm_notif_listener_desc">Needed to read your notifications aloud on command. Banking notifications are never read and OTP codes are always hidden.</string>
    <string name="perm_granted">✓ granted</string>
    <string name="perm_optional">optional</string>
    <string name="perm_required">required</string>
    <string name="perm_open_settings">Open system settings</string>
    <string name="perm_allow">Allow</string>
    <string name="onboarding_security_note">Security promise: NUVA never automates banking, bKash/Nagad/Rocket or any money transfer, never reads OTP/PIN/password, and always asks before calls, messages or reminders.</string>
