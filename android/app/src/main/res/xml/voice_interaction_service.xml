<?xml version="1.0" encoding="utf-8"?>
<!--
  Official Android default-assistant registration. Screen structure and
  screenshots are disabled again at runtime by NuvaVoiceInteractionService;
  NUVA only opens its own voice UI for an explicit assistant invocation.
-->
<voice-interaction-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:sessionService="com.nuva.assistant.systemassistant.NuvaVoiceInteractionSessionService"
    android:recognitionService="com.nuva.assistant.systemassistant.NuvaRecognitionService"
    android:settingsActivity="com.nuva.assistant.MainActivity"
    android:supportsAssist="true"
    android:supportsLaunchVoiceAssistFromKeyguard="false"
    android:supportsLocalInteraction="false" />
