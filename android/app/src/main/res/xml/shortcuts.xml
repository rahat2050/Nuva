<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="talk_to_nuva"
        android:enabled="true"
        android:icon="@drawable/ic_nuva_tile"
        android:shortcutShortLabel="@string/shortcut_talk_short"
        android:shortcutLongLabel="@string/shortcut_talk_long"
        android:shortcutDisabledMessage="@string/shortcut_talk_disabled">
        <intent
            android:action="com.nuva.assistant.action.QUICK_SPEAK"
            android:targetPackage="com.nuva.assistant"
            android:targetClass="com.nuva.assistant.MainActivity" />
    </shortcut>
</shortcuts>
