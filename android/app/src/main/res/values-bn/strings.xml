    <!-- v1.1: onboarding -->
    <string name="onboarding_title">নুভা সেটআপ</string>
    <string name="onboarding_intro">যে পারমিশন দরকার শুধু সেটাই, কখন দরকার তখনই চাওয়া হবে। সবই ঐচ্ছিক — না দিলে নুভা বলে দেবে কোন ফিচার কী কারণে বন্ধ থাকবে।</string>
    <string name="perm_mic_title">🎙 মাইক্রোফোন</string>
    <string name="perm_mic_desc">আপনার ভয়েস কমান্ড শোনার জন্য। শোনার ইন্ডিকেটর দেখা যাওয়ার সময়ই কেবল মাইক চলে — কখনো লুকিয়ে রেকর্ড করে না।</string>
    <string name="perm_notifications_title">🔔 নোটিফিকেশন</string>
    <string name="perm_notifications_desc">নুভার শোনার স্ট্যাটাস ও ফলাফল নোটিফিকেশনে দেখাতে। ঐচ্ছিক।</string>
    <string name="perm_accessibility_title">♿ অ্যাক্সেসিবিলিটি সার্ভিস</string>
    <string name="perm_accessibility_desc">স্ক্রিন পড়ে শোনানো ও আপনার বলা বাটনে চাপ দেওয়ার জন্য। সিস্টেম সেটিংস থেকে নিজ হাতে চালু করতে হয় — নুভা নিজে কখনো চালু করতে পারে না।</string>
    <string name="perm_contacts_title">👥 কন্টাক্ট</string>
    <string name="perm_contacts_desc">“রহিমকে কল করো” বললে নম্বর খুঁজতে। প্রথম কল/মেসেজ কমান্ডের সময়েই কেবল চাওয়া হয়।</string>
    <string name="perm_sms_title">✉ এসএমএস</string>
    <string name="perm_sms_desc">আপনি নিশ্চিত করার পর এসএমএস পাঠাতে। না দিলে নুভা লেখা বসিয়ে এসএমএস স্ক্রিন খুলে দেবে, সেন্ড আপনি চাপবেন।</string>
    <string name="perm_notif_listener_title">📩 নোটিফিকেশন অ্যাক্সেস</string>
    <string name="perm_notif_listener_desc">বললে নোটিফিকেশন পড়ে শোনানোর জন্য। ব্যাংকিং নোটিফিকেশন কখনো পড়া হয় না, OTP সবসময় লুকানো থাকে।</string>
