<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Voice input -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Vercel API + Supabase REST -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Foreground microphone session while listening (never silent recording) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- User-granted floating assistant popup shown only after activation. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Restore user-created local draft reminders after reboot/app update. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- CALL_CONTACT: ACTION_DIAL needs no permission; ACTION_CALL is used only
         when the user explicitly enabled direct calling in Settings. -->
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <!-- Contact-name search for call/message commands (requested in context,
         never at startup). -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <!-- Optional explicit agenda/event lookup; calendar writes remain in visible Calendar UI. -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <!-- SMS send ONLY after an explicit confirmation; without it NUVA falls
         back to the compose screen where the user taps Send. -->
    <uses-permission android:name="android.permission.SEND_SMS" />
    <!-- SET_ALARM via AlarmClock intents -->
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />

    <uses-feature
        android:name="android.hardware.microphone"
        android:required="true" />

    <!-- Package visibility for launching external apps (YouTube, WhatsApp, …) -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- Android 11+ package visibility: required for SpeechRecognizer
             discovery and for the non-recursive assistant recognizer bridge. -->
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <application
        android:name=".NuvaApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Nuva"
        tools:targetApi="34">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Nuva">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Activity fallback used by some OEM default-assistant pickers. -->
            <intent-filter>
                <action android:name="android.intent.action.ASSIST" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <!-- Explicit user handoff only: selected/shared text becomes a
                 local editable draft and is never submitted automatically. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.PROCESS_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- User-added Quick Settings tile. A tap only opens a visible NUVA
             listening session; it performs no command from the background. -->
        <service
            android:name=".service.NuvaQuickSettingsTileService"
            android:exported="true"
            android:icon="@drawable/ic_nuva_tile"
            android:label="@string/quick_tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Official Android digital-assistant integration. The user alone can
             select NUVA in Default apps; the app cannot replace Gemini silently. -->
        <service
            android:name=".systemassistant.NuvaVoiceInteractionService"
            android:exported="true"
            android:label="@string/system_assistant_label"
            android:permission="android.permission.BIND_VOICE_INTERACTION">
            <intent-filter>
                <action android:name="android.service.voice.VoiceInteractionService" />
            </intent-filter>
            <meta-data
                android:name="android.voice_interaction"
                android:resource="@xml/voice_interaction_service" />
        </service>

        <service
            android:name=".systemassistant.NuvaVoiceInteractionSessionService"
            android:exported="true"
            android:permission="android.permission.BIND_VOICE_INTERACTION" />

        <!-- Functional bridge to the user's installed STT provider. It never
             delegates to itself and never sends raw audio to NUVA's backend. -->
        <service
            android:name=".systemassistant.NuvaRecognitionService"
            android:exported="true"
            android:label="@string/system_recognition_label">
            <intent-filter>
                <action android:name="android.speech.RecognitionService" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data
                android:name="android.speech"
                android:resource="@xml/recognition_service" />
        </service>

        <!-- PHASE 2 UI automation: enabled manually by the user in system
             settings; NUVA can never enable it programmatically. -->
        <service
            android:name=".accessibility.NuvaAccessibilityService"
            android:exported="false"
            android:label="@string/accessibility_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- Microphone foreground session — runs only while actively listening,
             with a visible notification (§26: never silent recording). -->
        <service
            android:name=".service.NuvaForegroundService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!-- Opt-in wake-word fallback. Runs as a visible foreground microphone
             service; the user can stop it from Settings or the notification. -->
        <service
            android:name=".service.WakeWordService"
            android:exported="false"
            android:foregroundServiceType="microphone"
            android:stopWithTask="false" />

        <!-- Notification READER (v1.1): summary only — never replies/dismisses.
             The user enables "Notification access" manually in system settings. -->
        <receiver
            android:name=".automation.ScheduledComposeReceiver"
            android:exported="false" />
        <receiver
            android:name=".automation.ScheduledComposeBootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <service
            android:name=".service.NuvaNotificationListener"
            android:exported="true"
            android:label="@string/notification_listener_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
