{
  "name": "nuva-backend",
  "version": "1.0.0",
  "private": true,
  "description": "NUVA v1.0 secure API gateway — Vercel serverless functions bridging the Android app to Groq and Supabase",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "tsx watch dev/server.ts",
    "eval": "tsx scripts/eval-models.ts",
    "verify": "npm run build && npm run test"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "@vercel/node": "^5.1.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vitest": "^2.1.2"
  }
}
