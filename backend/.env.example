# ---------------------------------------------------------------------------
# NUVA backend environment (PHRASE 1)
#
# Copy to `.env.local` for local development:   cp .env.example .env.local
# In production these are set as Vercel Project Environment Variables.
#
# SECURITY (master prompt §12):
#   * Never commit a filled-in copy of this file.
#   * SUPABASE_SERVICE_ROLE_KEY and GROQ_API_KEY are SERVER-ONLY.
#     They must never appear in the Android app, in logs, or in an API response.
# ---------------------------------------------------------------------------

# --- Groq (AI reasoning) ---------------------------------------------------
# Required for real AI parsing. Without it the backend still boots and serves
# /api/health, and /api/ai/command degrades to the deterministic fallback parser.
GROQ_API_KEY=

# Groq production models (verified 2026-08-23).
# NOTE: llama-3.3-70b-versatile and llama-3.1-8b-instant were SHUT DOWN 2026-08-16.
# gpt-oss-20b  ~1000 t/s  -> lowest latency, default for voice command parsing
# gpt-oss-120b ~500 t/s   -> stronger reasoning, used as automatic fallback
GROQ_MODEL=openai/gpt-oss-20b
GROQ_FALLBACK_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1
# 8000ms fits inside Vercel Hobby 10s maxDuration; 12000ms caused timeouts
GROQ_TIMEOUT_MS=8000
# low | medium | high  (empty string disables the parameter)
GROQ_REASONING_EFFORT=low

# --- Supabase (auth, history, memory) --------------------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server-only. Bypasses Row Level Security — keep it out of the client forever.
SUPABASE_SERVICE_ROLE_KEY=

# --- NUVA behaviour --------------------------------------------------------
# When true, /api/ai/command, /api/commands and /api/memory require a valid
# Supabase user JWT (Authorization: Bearer <access_token>).
NUVA_REQUIRE_AUTH=false
# Persist conversations/commands/memories. Requires the service role key.
NUVA_PERSIST=true
# Allow the deterministic offline parser when Groq is unavailable/unconfigured.
NUVA_ALLOW_FALLBACK_PARSER=true
# Comma-separated origins, or * (the Android app sends no Origin header).
NUVA_ALLOWED_ORIGINS=*
# Best-effort per-identity request cap per minute (per serverless instance).
NUVA_RATE_LIMIT_PER_MIN=60
# debug | info | warn | error
NUVA_LOG_LEVEL=info

# --- Cloudinary (media storage) -------------------------------------------
# Declared for completeness (master prompt §18). NOT used in PHRASE 1 — no code
# reads these yet. CLOUDINARY_API_SECRET must never reach the Android app.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Local dev server only -------------------------------------------------
PORT=3000
